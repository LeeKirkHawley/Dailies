<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Dailies.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dailies"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dailies">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="BottomRow" Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recurring"/>
                    <Button x:Name="AddRecurringTaskButton" 
                        Content="Add Recurring Task" 
                        Click="AddRecurringTaskButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="VerticalSplitter"
                Grid.Column="1"
                Width="6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                PointerPressed="Splitter_PointerPressed"
                PointerMoved="Splitter_PointerMoved"
                PointerReleased="Splitter_PointerReleased"
                PointerCaptureLost="Splitter_PointerReleased"/>

            <Border Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12">
                <TextBlock Text="One-Time"/>
            </Border>
        </Grid>

        <Border x:Name="HorizontalSplitter"
            Grid.Row="1"
            Height="6"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            PointerPressed="Splitter_PointerPressed"
            PointerMoved="Splitter_PointerMoved"
            PointerReleased="Splitter_PointerReleased"
            PointerCaptureLost="Splitter_PointerReleased"/>

        <Border Grid.Row="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Padding="12">
            <StackPanel Spacing="12">
                <TextBlock Text="Today's Tasks"/>
            </StackPanel>
        </Border>
    </Grid>
    
</Window>
